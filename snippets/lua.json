{
  "styignore": {
    "prefix": "styignore",
    "body": ["-- stylua: ignore"],
    "description": "Stylua ignore"
  },
  "safely": {
    "prefix": "safely",
    "body": [
      "require(\"mini.misc\").safely(\"event:$1\", function()",
      "  require(\"$2\").setup($3)",
      "end)"
    ],
    "description": "safely"
  },
  "lazyload": {
    "prefix": "lazyload",
    "body": [
      "require(\"utils.lazy\").load({",
      "  setup = function()",
      "    $1",
      "  end,",
      "  keys = { $2 },",
      "  cmd = { $3 },",
      "})"
    ],
    "description": "Lazy load plugin config"
  },
  "vscode": {
    "prefix": "novscode",
    "body": ["if vim.g.vscode then return end"],
    "description": "Disable plugin in vscode"
  }
}
